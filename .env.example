# Copy this file to .env for local development. Never commit .env.
APS_CLIENT_ID="your-aps-client-id"
APS_CLIENT_SECRET="your-aps-client-secret"

# Leave APS_BUCKET empty to derive a persistent bucket name from the client ID.
APS_BUCKET=""

# Set this after uploading and translating the model once.
APS_DEFAULT_MODEL_URN=""

# Keep these false for a public demo. Enable uploads only on a trusted local instance.
APS_ENABLE_UPLOADS=false
APS_ENABLE_MODEL_SELECTION=false

# Optional locally; deployment providers usually set PORT automatically.
PORT=8080
